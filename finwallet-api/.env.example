# Copy to .env only if needed. Replace the placeholders before starting Spring.
SPRING_DATASOURCE_URL='jdbc:postgresql://127.0.0.1:5432/finwallet'
SPRING_DATASOURCE_USERNAME='finwallet_user'
SPRING_DATASOURCE_PASSWORD='REPLACE_WITH_LOCAL_DATABASE_PASSWORD'
# Generate with: openssl rand -hex 64
JWT_SECRET='REPLACE_ME'
JWT_EXPIRATION_SECONDS=900

# Local-only listener and funding options.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=none
FINWALLET_DEV_FUNDING_ENABLED=false
# Generate a separate token with: openssl rand -hex 32
# FINWALLET_DEV_FUNDING_TOKEN='REPLACE_WITH_RANDOM_DEV_FUNDING_TOKEN'
FINWALLET_DEV_API_URL='http://127.0.0.1:8080'
